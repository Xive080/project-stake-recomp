+// ---- IPU DMA (toIPU = channel 4, fromIPU = channel 3) ----
+bool PS2Memory::tryProcessIpuDma(uint32_t channelBase, uint32_t chcr)
+{
+    constexpr uint32_t kFromIpu = 0x1000B000u;
+    constexpr uint32_t kToIpu = 0x1000B400u;
+    if (channelBase != kFromIpu && channelBase != kToIpu)
+        return false;
+
+    m_ioRegisters[channelBase] = chcr | 0x100u;
+    if (channelBase == kFromIpu)
+    {
+        m_ipuFromPending = true;
+        pumpIpuFromDma();
+        return true;
+    }
+
+    auto feed = [&](uint32_t src, uint32_t qwc)
+    {
+        for (uint32_t i = 0; i < qwc; ++i, src += 16u)
+        {
+            const bool scratch = isScratchpad(src);
+            const uint32_t phys = translateAddress(src);
+            const uint8_t *base = scratch ? m_scratchpad : m_rdram;
+            const uint32_t lim = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            if (phys + 16u > lim)
+                break;
+            ps2_ipu::pushInput(base + phys, 16);
+        }
+    };
+
+    const uint32_t mode = (chcr >> 2) & 3u;
+    if (mode == 0u)
+    {
+        const uint32_t madr = m_ioRegisters[kToIpu + 0x10u];
+        const uint32_t qwc = m_ioRegisters[kToIpu + 0x20u] & 0xFFFFu;
+        feed(madr, qwc);
+        m_ioRegisters[kToIpu + 0x10u] = madr + qwc * 16u;
+        m_ioRegisters[kToIpu + 0x20u] = 0u;
+    }
+    else
+    {
+        uint32_t tadr = m_ioRegisters[kToIpu + 0x30u];
+        uint32_t lastChcr = chcr;
+        for (int tags = 0; tags < 65536; ++tags)
+        {
+            const bool tsc = isScratchpad(tadr);
+            const uint32_t tp = translateAddress(tadr);
+            const uint8_t *tb = tsc ? m_scratchpad : m_rdram;
+            const uint32_t tl = tsc ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            if (tp + 16u > tl)
+                break;
+            uint64_t tag;
+            std::memcpy(&tag, tb + tp, 8);
+            const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            const uint32_t id = static_cast<uint32_t>((tag >> 28) & 7u);
+            const bool irq = ((tag >> 31) & 1u) != 0u;
+            const uint32_t addr = static_cast<uint32_t>(tag >> 32);
+            lastChcr = (chcr & 0xFFFFu) | (static_cast<uint32_t>(tag) & 0xFFFF0000u);
+            bool end = false;
+            uint32_t src = addr;
+            switch (id)
+            {
+            case 0: tadr += 16u; end = true; break;                  // REFE
+            case 1: src = tadr + 16u; tadr = src + qwc * 16u; break; // CNT
+            case 2: src = tadr + 16u; tadr = addr; break;            // NEXT
+            case 3: case 4: tadr += 16u; break;                      // REF / REFS
+            case 7: src = tadr + 16u; end = true; break;             // END
+            default: end = true; break;
+            }
+            feed(src, qwc);
+            m_ioRegisters[kToIpu + 0x10u] = src + qwc * 16u;
+            if (end || (irq && (chcr & 0x80u)))
+                break;
+        }
+        m_ioRegisters[kToIpu + 0x30u] = tadr;
+        m_ioRegisters[kToIpu + 0x20u] = 0u;
+        m_ioRegisters[kToIpu] = lastChcr | 0x100u;
+    }
+    completeDmacChannel(kToIpu, 4u);
+    pumpIpuFromDma();
+    return true;
+}
+
+void PS2Memory::pumpIpuFromDma()
+{
+    constexpr uint32_t kFromIpu = 0x1000B000u;
+    if (!m_ipuFromPending)
+        return;
+    uint32_t qwc = m_ioRegisters[kFromIpu + 0x20u] & 0xFFFFu;
+    uint32_t madr = m_ioRegisters[kFromIpu + 0x10u];
+    while (qwc > 0)
+    {
+        const size_t availQw = ps2_ipu::outputBytes() / 16u;
+        if (availQw == 0)
+            break;
+        const uint32_t n = static_cast<uint32_t>(std::min<size_t>(availQw, qwc));
+        const bool scratch = isScratchpad(madr);
+        const uint32_t phys = translateAddress(madr);
+        uint8_t *base = scratch ? m_scratchpad : m_rdram;
+        const uint32_t lim = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        uint32_t nn = n;
+        if (phys + nn * 16u > lim)
+            nn = (lim > phys) ? (lim - phys) / 16u : 0u;
+        if (nn == 0)
+        {
+            uint8_t sink[16];
+            ps2_ipu::popOutput(sink, 16);
+            qwc--;
+            madr += 16u;
+            continue;
+        }
+        ps2_ipu::popOutput(base + phys, static_cast<size_t>(nn) * 16u);
+        qwc -= nn;
+        madr += nn * 16u;
+    }
+    m_ioRegisters[kFromIpu + 0x20u] = qwc;
+    m_ioRegisters[kFromIpu + 0x10u] = madr;
+    if (qwc == 0)
+    {
+        m_ipuFromPending = false;
+        completeDmacChannel(kFromIpu, 3u);
+    }
+}
