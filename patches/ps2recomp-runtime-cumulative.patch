--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_gif_path_context.h
@@ -0,0 +1,25 @@
+#ifndef PS2_GS_GIF_PATH_CONTEXT_H
+#define PS2_GS_GIF_PATH_CONTEXT_H
+
+// Interno del runtime (no se instala en include/): indica a GS::processGIFPacket por que PATH del GIF llega el paquete que
+// se procesa. El GIF real guarda el estado del tag en curso (NLOOP restante, registro actual, FLG/NREG/REGS) por camino:
+// un tag PACKED/REGLIST/IMAGE puede continuar en la siguiente transferencia (DIRECT tras DIRECT en PATH2, otra
+// transferencia DMA en PATH3). Con path 0 (llamada directa sin arbitro) el procesado sigue siendo sin estado.
+namespace gs_gif_path
+{
+    int current();
+    void setCurrent(int path);
+
+    struct Scope
+    {
+        explicit Scope(int path) : m_prev(current()) { setCurrent(path); }
+        ~Scope() { setCurrent(m_prev); }
+        Scope(const Scope &) = delete;
+        Scope &operator=(const Scope &) = delete;
+
+    private:
+        int m_prev;
+    };
+}
+
+#endif
