+// --- Overlays de Vampire Night: tablas de funciones por modulo (ver docs/OVERLAYS.md del repo project-stake-recomp) ---
+struct OverlayTable { int idx; const char *name; uint32_t base, end; PS2Runtime::RecompiledFunction *table; };
+#if defined(__GNUC__)
+extern const OverlayTable g_overlayTables[] __attribute__((weak));
+extern const int g_overlayTableCount __attribute__((weak));
+#else
+extern const OverlayTable g_overlayTables[];
+extern const int g_overlayTableCount;
+#endif
+
+namespace
+{
+    // Ventana de overlay a la que pertenece una direccion y modulo cargado ahora en ella (idx en la cabecera MWo3, +4).
+    PS2Runtime::RecompiledFunction overlayLookup(const uint8_t *rdram, uint32_t address)
+    {
+        static const uint32_t kWindows[] = {0x92B000u, 0x9C4800u, 0x9DF000u, 0xA0F800u};
+        if (rdram == nullptr || g_overlayTables == nullptr || (address & 3u) != 0u || address < kWindows[0])
+        {
+            return nullptr;
+        }
+        uint32_t win = 0u;
+        for (uint32_t w : kWindows)
+        {
+            if (address >= w)
+            {
+                win = w;
+            }
+        }
+        uint32_t idx = 0u;
+        std::memcpy(&idx, rdram + win + 4u, sizeof(idx));
+        for (int i = 0; i < g_overlayTableCount; ++i)
+        {
+            const OverlayTable &t = g_overlayTables[i];
+            if (t.idx == static_cast<int>(idx) && address >= t.base && address < t.end)
+            {
+                return t.table[(address - t.base) >> 2];
+            }
+        }
+        return nullptr;
+    }
+}
